{
    "namespace": "gregtech",

    "fluid_slot_background": {
        "type": "panel",
        "controls": [
            {
                "cell_image": {
                    "type": "image",
                    "texture": "textures/ui/gregtech/fluid_cell_image",
                    "layer": 1,
                    "$cell_selected_binding_name|default": "#is_selected_slot",
                    "visible": true,
                    "bindings": [
                        {
                            "binding_name": "(not $cell_selected_binding_name)",
                            "binding_name_override": "#visible",
                            "binding_type": "collection",
                            "binding_collection_name": "$item_collection_name"
                        }
                    ]
                }
            },
            {
                "cell_image_selected": {
                    "type": "image",
                    "texture": "textures/ui/gregtech/fluid_cell_selected",
                    "layer": 1,
                    "$cell_selected_binding_name|default": "#is_selected_slot",
                    "visible": false,
                    "bindings": [
                        {
                            "binding_name": "$cell_selected_binding_name",
                            "binding_name_override": "#visible",
                            "binding_type": "collection",
                            "binding_collection_name": "$item_collection_name"
                        }
                    ]
                }
            }
        ]
    },

    "overlay_image": {
        "ignored": "($overlay_texture = 'unset')",
        "type":"image",
        "texture": "$overlay_texture",
        "size": [18, 18]
    }
}